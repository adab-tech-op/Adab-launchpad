# Neon Postgres — server-side connection string (pooled).
# Get it from the Neon console → your project → Connection Details.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Better Auth (self-hosted). Its tables live in your Neon DB (run db/auth-schema.sql).
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_32_BYTE_STRING
BETTER_AUTH_URL=https://your-domain.com   # your site's base URL (prod)

# Optional: absolute site URL for sitemap.xml / OG metadata (e.g. https://adab.co)
# NEXT_PUBLIC_SITE_URL=

# Resend — transactional email (order confirmations; later, Better Auth verification/reset).
# Create an API key at resend.com and verify your sending domain (e.g. adab.co).
RESEND_API_KEY=re_xxxxxxxxxxxx
ADAB_FROM_EMAIL=ADAB <orders@adab.co>
ADAB_NOTIFY_EMAIL=hello@adab.co

# Studio admin access — comma-separated emails allowed into /studio.
ADMIN_EMAILS=you@example.com

# Manual bKash bridge — the merchant/receiving number shown on the payment page
# (the number customers send money TO). Swap for a gateway once merchant-approved.
ADAB_BKASH_NUMBER=01XXXXXXXXX

# Cloudinary — unsigned image uploads from /studio (public identifiers; safe to expose).
# Defaults are baked in; override here only if you change accounts/presets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=oma9klak
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=Adab Launchpad
